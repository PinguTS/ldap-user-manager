{
    "name": "ldap-user-manager/ldap-user-manager",
    "description": "LDAP User Management System",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LdapUserManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LdapUserManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 www/",
        "cs-fix": "phpcbf --standard=PSR12 www/",
        "stan": "phpstan analyse www/ --level=max",
        "fix": "php-cs-fixer fix www/",
        "rector": "rector process www/ --dry-run"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
